# ─────────────────────────────────────────────────────────────
# EmblemWay backend configuration. Copy to .env and fill in.
# NEVER commit real secrets. See docs/ENVIRONMENT_CONFIGURATION.md
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info
# Comma separated list of allowed browser origins (admin dashboard).
CORS_ORIGINS=http://localhost:3001
# Public base URL used to build profile image URLs.
PUBLIC_BASE_URL=http://localhost:3000

# Database (docker compose maps PostGIS to host port 5433)
DATABASE_URL=postgresql://emblemway:emblemway_dev_password@localhost:5433/emblemway?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379

# JWT - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC pepper for OTP & refresh-token hashing - generate with: openssl rand -base64 48
HASH_PEPPER=change-me-hash-pepper-at-least-32-characters

# OTP
# mock | twilio   (mock is refused when NODE_ENV=production)
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Per-IP cap on OTP requests per hour
OTP_MAX_SENDS_PER_IP_PER_HOUR=30
# Per-IP request throttling (cannot be disabled in staging/production)
THROTTLE_ENABLED=true
# Only used by the mock provider (development / automated tests).
MOCK_OTP_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Maps Platform (SERVER key: restrict by IP + to Routes, Places, Geocoding APIs)
# mock | google   (mock is refused when NODE_ENV=production)
MAPS_PROVIDER=mock
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_API_TIMEOUT_MS=8000
GOOGLE_API_MAX_RETRIES=2
GOOGLE_ROUTES_DAILY_QUOTA=5000
GOOGLE_ROUTES_MAX_RPS=10
TRAFFIC_CACHE_TTL_SECONDS=300

# Push notifications (Firebase Admin). Paste the service-account JSON as base64.
# none | fcm
PUSH_PROVIDER=none
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Admin bootstrap (created by the seed script if it does not exist)
ADMIN_BOOTSTRAP_EMAIL=admin@emblemway.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Admin2026

# Storage for profile images
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=3145728

# Background jobs
JOBS_ENABLED=true
# Location data retention for finished journeys (days)
LOCATION_RETENTION_DAYS=180
