{
  "name": "@emblemway/backend",
  "version": "1.0.0",
  "description": "EmblemWay API - journeys, geospatial route matching, traffic prediction and hotspots",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.ts",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:all": "npm run test:cov && npm run test:integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "benchmark:matching": "ts-node --transpile-only scripts/benchmark-matching.ts",
    "test:coverage": "jest --config jest.coverage.config.ts --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.0.2",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "dotenv": "16.6.1",
    "dotenv-cli": "8.0.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
